SECRET_KEY="change-me"
DEBUG=True
DATABASE_URL="sqlite:///db.sqlite3"

# Free options: ddgs | ddgs_html | bing_html | fallback (auto chain of free engines)
SEARCH_PROVIDER="ddgs"
# Order of free layers used when SEARCH_PROVIDER="fallback"
SEARCH_FALLBACK_PROVIDERS="ddgs,ddgs_html,bing_html"
DDGS_BACKEND="yahoo,startpage,mojeek,yandex"
TAVILY_API_KEY=""
BRAVE_API_KEY=""
GOOGLE_API_KEY=""
GOOGLE_CSE_ID=""

GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

YOUTUBE_API_KEY=""

AMAZON_PROVIDER="search_result"
AMAZON_CREATORS_CLIENT_ID=""
AMAZON_CREATORS_CLIENT_SECRET=""
AMAZON_CREATORS_MARKETPLACE="US"
AMAZON_ASSOCIATE_TAG=""

APP_MAX_BOOKS_PER_RUN=25
APP_MAX_SEARCH_RESULTS_PER_QUERY=10
APP_MAX_DISCOVERY_QUERIES=12
APP_MAX_AUTHOR_DISCOVERY_QUERIES=8
APP_MAX_DEEP_CONTACT_QUERIES=5
APP_MAX_AUTHOR_PAGES_TO_CRAWL=5
APP_REQUEST_TIMEOUT_SECONDS=15
APP_REQUEST_DELAY_SECONDS=0.35
APP_SEARCH_DELAY_SECONDS=0.2
APP_CRAWL_DELAY_SECONDS=0.35
APP_SOCIAL_CRAWL_DELAY_SECONDS=0.5
APP_MAX_SOCIAL_CONTACT_PAGES=5
APP_DNS_TIMEOUT_SECONDS=1.0
APP_SCHEDULED_TASK_LEASE_SECONDS=21600
APP_SEARCH_CACHE_SECONDS=21600
APP_MAX_GROQ_INPUT_CHARS=12000
# Cache identical Groq completions for 24h so re-runs don't re-spend API quota.
APP_GROQ_CACHE_SECONDS=86400
# Parallel books per pipeline run (1 = sequential, 3 recommended with WAL SQLite).
APP_PIPELINE_WORKERS=3
# Concurrent network operations inside each book stage (search queries, page fetches, video lookups).
APP_STAGE_WORKERS=4
# Free no-key Wikidata/Wikipedia author lookup (official site + verified social profiles).
APP_WIKIDATA_AUTHOR_LOOKUP=true

# Leave unset unless you have permission from BookLife to crawl their pages.
BOOKLIFE_DIRECT_FETCH_ALLOWED=0

# Optional. Browse pages already include title, author, cover, category, and summary.
# Detail pages may challenge automated requests, so leave this off unless needed.
BOOKLIFE_FETCH_PROJECT_DETAILS=0

# --- Lead-scraping feature toggles (added 2026-08-18) ---
# Headless JS rendering fallback for JS-built author sites (requires: pip install playwright && playwright install chromium).
APP_JS_RENDER_ENABLED=0
APP_JS_RENDER_MIN_TEXT_CHARS=200
# Comma-separated egress proxies for crawl traffic. Empty = direct connections.
APP_PROXY_LIST=
# Hosted email verification provider: hunter | zerobounce | neverbounce (empty = off).
# Set the matching key: HUNTER_API_KEY / ZEROBOUNCE_API_KEY / NEVERBOUNCE_API_KEY.
APP_EMAIL_VERIFY_PROVIDER=
HUNTER_API_KEY=
ZEROBOUNCE_API_KEY=
NEVERBOUNCE_API_KEY=
# Contacts older than this many days are flagged stale; re-check with:
#   python manage.py reverify_stale_contacts
APP_CONTACT_STALE_DAYS=90
# Same contact value on this many leads = shared agency/publicist channel.
APP_SHARED_CONTACT_THRESHOLD=3
# Slack/Discord/generic webhook for run-completion and hot-lead notifications.
APP_WEBHOOK_URL=
APP_HOT_LEAD_NOTIFY_SCORE=90
