SECRET_KEY="change-me"
DEBUG=True
DATABASE_URL="sqlite:///db.sqlite3"

SEARCH_PROVIDER="ddgs"
TAVILY_API_KEY=""
BRAVE_API_KEY=""
GOOGLE_API_KEY=""
GOOGLE_CSE_ID=""

GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

YOUTUBE_API_KEY=""

AMAZON_PROVIDER="search_result"
AMAZON_CREATORS_CLIENT_ID=""
AMAZON_CREATORS_CLIENT_SECRET=""
AMAZON_CREATORS_MARKETPLACE="US"
AMAZON_ASSOCIATE_TAG=""

APP_MAX_BOOKS_PER_RUN=25
APP_MAX_SEARCH_RESULTS_PER_QUERY=10
APP_MAX_DISCOVERY_QUERIES=12
APP_MAX_AUTHOR_DISCOVERY_QUERIES=8
APP_MAX_DEEP_CONTACT_QUERIES=5
APP_MAX_AUTHOR_PAGES_TO_CRAWL=5
APP_REQUEST_TIMEOUT_SECONDS=15
APP_REQUEST_DELAY_SECONDS=0.35
APP_SEARCH_DELAY_SECONDS=0.2
APP_CRAWL_DELAY_SECONDS=0.35
APP_SOCIAL_CRAWL_DELAY_SECONDS=0.5
APP_MAX_SOCIAL_CONTACT_PAGES=5
APP_DNS_TIMEOUT_SECONDS=1.0
APP_SCHEDULED_TASK_LEASE_SECONDS=21600
APP_SEARCH_CACHE_SECONDS=21600
APP_MAX_GROQ_INPUT_CHARS=12000

# Leave unset unless you have permission from BookLife to crawl their pages.
BOOKLIFE_DIRECT_FETCH_ALLOWED=0

# Optional. Browse pages already include title, author, cover, category, and summary.
# Detail pages may challenge automated requests, so leave this off unless needed.
BOOKLIFE_FETCH_PROJECT_DETAILS=0
